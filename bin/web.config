<?xml version="1.0" encoding="UTF-8"?>
<!-- Carpeta privada: IIS no debe servir ningún archivo de aquí. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="false" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
