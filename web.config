<?xml version="1.0" encoding="UTF-8"?>
<!-- Solo aplica si todo el repositorio quedó dentro de la raíz web en IIS. Lo recomendado es apuntar la raíz a public/. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="storage" />
          <add segment="config" />
          <add segment="src" />
          <add segment="bin" />
          <add segment="tests" />
          <add segment="docs" />
          <add segment="design" />
          <add segment="node_modules" />
          <add segment="graphify-out" />
          <add segment=".git" />
          <add segment=".claude" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
